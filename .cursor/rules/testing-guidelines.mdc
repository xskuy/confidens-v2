import pytest

@pytest.mark.parametrize(("a", "b", "resultado"), [
    (1,  1, 2),
    (2, -1, 1),
    (0,  0, 0),
])
def test_suma(a: int, b: int, resultado: int) -> None:
    assert a + b == resultado
